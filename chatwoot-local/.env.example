# Copy to .env and fill in the secrets (openssl rand -hex 64 / -hex 16)
SECRET_KEY_BASE=
FRONTEND_URL=http://localhost:3001
DEFAULT_LOCALE=es
ENABLE_ACCOUNT_SIGNUP=false
FORCE_SSL=false
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ACTIVE_STORAGE_SERVICE=local
MAILER_SENDER_EMAIL=Chatwoot <noreply@localhost>

# Privacy: do not send metrics or events to hub.2.chatwoot.com
DISABLE_TELEMETRY=true
# Do not relay mobile push notifications through the Chatwoot hub
ENABLE_PUSH_RELAY_SERVER=false
